# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=toxiscan

# Any long random string in production
JWT_SECRET_KEY=change-this-in-production

# Hugging Face Spaces used for skin analysis (gradio_client space ids)
HF_SKIN_CLASSIFIER_SPACE=Omkarrrrr/SkinClassifierSpace
HF_SKIN_CONDITION_SPACE=Omkarrrrr/yolo

# Get a free token at huggingface.co/settings/tokens (role: read is enough).
# Without this, calls share the public anonymous-usage quota, which is very
# easy to exhaust (especially for ZeroGPU-backed Spaces like the condition detector).
HF_TOKEN=
